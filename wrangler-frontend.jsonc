{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scb-frontend",
  "main": "frontend-worker.js",
  "compatibility_date": "2026-07-02",
  "workers_dev": true,
  "routes": [
    { "pattern": "scb.tapwaterpauper.com/*", "zone_id": "d1127cba1a97e14f0beb63650988938f" }
  ],
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "services": [
    { "binding": "API_GATEWAY", "service": "scb-api-gateway" }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
